# AutoAnnotate environment configuration
# Copy this file to .env and fill in paths for your machine.

# Absolute path to the GroundingDINO directory
# Example (macOS):  /Users/yourname/Projects/AutoAnnotate/autoannotate study/GroundingDINO
# Example (Windows): C:\Users\yourname\Projects\AutoAnnotate\GroundingDINO
GROUNDING_DINO_DIR=

# Hugging Face token (from https://huggingface.co/settings/tokens) — required
# by the GUI to download SAM/YOLOE weights and any gated model checkpoints.
HF_TOKEN=

# Roboflow API key (from https://app.roboflow.com/settings/api) — only needed
# if you re-run the dataset-download cells in autoannotate study/grounding-dino-sam.ipynb.
ROBOFLOW_API_KEY=
