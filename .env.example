# AutoAnnotate environment configuration
# Copy this file to .env and fill in paths for your machine.

# Absolute path to the GroundingDINO directory
# Example (macOS):  /Users/yourname/Projects/AutoAnnotate/autoannotate study/GroundingDINO
# Example (Windows): C:\Users\yourname\Projects\AutoAnnotate\GroundingDINO
GROUNDING_DINO_DIR=

# Hugging Face token (from https://huggingface.co/settings/tokens). OPTIONAL and
# the running app never uses it. SAM2/YOLOE come from ultralytics' server, the
# other models (bert-base-uncased for DINO, SmolVLM, Stable Diffusion 1.5) are
# public, and sam3.pt is loaded from disk -- no model load passes a token. Leave
# this blank to run token-free. A token only helps OUTSIDE the app, for the
# one-time manual download of the gated sam3.pt from facebook/sam3; once that
# file is in "GUI and Pipeline/", nothing reads this value.
HF_TOKEN=

# Roboflow API key (from https://app.roboflow.com/settings/api). Only needed if
# you re-run the dataset-download cells in autoannotate study/grounding-dino-sam.ipynb.
ROBOFLOW_API_KEY=
